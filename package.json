{
  "name": "api-productos",
  "version": "1.0.0",
  "description": "API REST de productos con Node.js, Express, Prisma y PostgreSQL (N capas + MVC + Singleton + Repository + Chain of Responsibility)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push"
  },
  "keywords": [
    "express",
    "postgresql",
    "rest-api",
    "repository",
    "singleton",
    "chain-of-responsibility"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
